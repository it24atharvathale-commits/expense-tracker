pipeline {
    agent any
    environment {
        IMAGE_NAME = 'YOUR_DOCKERHUB_USERNAME/expense-calculator'
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Maven Build') {
            steps { sh 'mvn -B clean package -DskipTests' }
        }
        stage('Start App and Selenium Tests') {
            steps {
                sh '''
                    set -eu
                    java -jar target/expense-calculator-1.0.0.jar > server.log 2>&1 &
                    echo $! > server.pid
                    ready=0
                    for i in $(seq 1 30); do
                      if curl -fsS http://localhost:8080/health >/dev/null; then ready=1; break; fi
                      sleep 2
                    done
                    if [ "$ready" -ne 1 ]; then cat server.log; echo "App failed to start"; exit 1; fi
                    mvn -B test
                '''
            }
            post {
                always {
                    sh 'if [ -f server.pid ]; then kill "$(cat server.pid)" 2>/dev/null || true; fi'
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                    archiveArtifacts artifacts: 'server.log', allowEmptyArchive: true
                }
            }
        }
        stage('Build Docker Image') {
            steps { sh 'docker build -t "$IMAGE_NAME:latest" .' }
        }
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        set +x
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push "$IMAGE_NAME:latest"
                        docker logout
                    '''
                }
            }
        }
    }
    post { always { echo 'Check each stage and the Selenium test report for results.' } }
}
